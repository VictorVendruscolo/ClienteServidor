{
  "configurations": [
    {
      "name": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**",
        "/usr/include",
        "/usr/include/x86_64-linux-gnu",
        "/usr/local/include"
      ],
      "defines": [
        "_POSIX_C_SOURCE=200809L",
        "_DEFAULT_SOURCE"
      ],
      "compilerPath": "/usr/bin/gcc",
      "compilerArgs": [
        "-pthread"
      ],
      "cStandard": "gnu17",
      "cppStandard": "gnu++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
